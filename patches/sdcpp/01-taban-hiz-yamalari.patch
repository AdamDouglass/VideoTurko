+static bool sd_attn_dump_cb(struct ggml_tensor* t, bool ask, void* /*user*/) {
+    if (std::strncmp(t->name, "attn_dump_", 10) != 0) {
+        return ask ? false : true;
+    }
+    if (ask) {
+        return true;
+    }
+    const char* dir = std::getenv("SD_ATTN_DUMP_DIR");
+    int idx         = 0;
+    char kind[16]   = {0};
+    if (dir != nullptr && std::sscanf(t->name, "attn_dump_%d_%15s", &idx, kind) == 2) {
+        std::vector<char> buf(ggml_nbytes(t));
+        ggml_backend_tensor_get(t, buf.data(), 0, buf.size());
+        char path[1024];
+        std::snprintf(path, sizeof(path), "%s/%d_%s.bin", dir, idx, kind);
+        if (FILE* f = std::fopen(path, "wb")) {
+            std::fwrite(buf.data(), 1, buf.size(), f);
+            std::fclose(f);
+        }
+        if (std::strcmp(kind, "q") == 0) {
+            std::snprintf(path, sizeof(path), "%s/%d_meta.txt", dir, idx);
+            if (FILE* f = std::fopen(path, "w")) {
+                std::fprintf(f, "%lld %lld %lld\n", (long long)t->ne[0], (long long)t->ne[1], (long long)t->ne[2]);
+                std::fclose(f);
+            }
+        }
+    }
+    return true;
