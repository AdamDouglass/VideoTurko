+static const std::set<int>& sd_attn_dump_set() {
+    static const std::set<int> s = []() -> std::set<int> {
+        std::set<int> out;
+        const char* e = std::getenv("SD_ATTN_DUMP_IDX");
+        const char* d = std::getenv("SD_ATTN_DUMP_DIR");
+        if (e == nullptr || d == nullptr) {
+            return out;
+        }
+        std::string list = e;
+        size_t pos = 0;
+        while (pos < list.size()) {
+            size_t comma = list.find(',', pos);
+            if (comma == std::string::npos) {
+                comma = list.size();
+            }
+            out.insert(std::atoi(list.substr(pos, comma - pos).c_str()));
+            pos = comma + 1;
+        }
+        return out;
+    }();
+    return s;
