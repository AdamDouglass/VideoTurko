From 73c9631b483694e53809ebb590f65ec514a6dc29 Mon Sep 17 00:00:00 2001
From: VideoTurko <noreply@example.invalid>
Date: Wed, 18 Nov 2026 22:38:01 +0300
Subject: [PATCH 09/23] 0006b: SD_QKV_CHUNK_MB env (default off)

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/model/diffusion/minimax_h3.hpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/model/diffusion/minimax_h3.hpp b/src/model/diffusion/minimax_h3.hpp
index bc422f8..71216b3 100644
--- a/src/model/diffusion/minimax_h3.hpp
+++ b/src/model/diffusion/minimax_h3.hpp
@@ -376,6 +376,15 @@ namespace MiniMaxH3 {
                 // This is a conservative chunk budget, not an operation support limit.
                 size_t chunk_budget = ggml_backend_buft_get_max_size(buft);
                 chunk_budget -= chunk_budget % alignment;
+                {
+                    static const size_t qkv_chunk_cap = [] {
+                        const char* e = std::getenv("SD_QKV_CHUNK_MB");
+                        return (e != nullptr && e[0] != '\0') ? static_cast<size_t>(std::atoll(e)) * 1024ULL * 1024ULL : static_cast<size_t>(0);
+                    }();
+                    if (qkv_chunk_cap > 0) {
+                        chunk_budget = std::min(chunk_budget, std::max<size_t>(alignment, qkv_chunk_cap));
+                    }
+                }
                 size_t token_bytes = ggml_row_size(GGML_TYPE_F32, 3 * heads * head_dim) * inputs[0]->ne[2] * inputs[0]->ne[3];
                 chunk_size         = static_cast<int64_t>(std::min<size_t>(chunk_size, std::max<size_t>(1, chunk_budget / token_bytes)));
             }
