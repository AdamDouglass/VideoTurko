From 0df3a3cb6dad27c26538bc079436329235bccbad Mon Sep 17 00:00:00 2001
From: VideoTurko <noreply@example.invalid>
Date: Thu, 19 Nov 2026 01:42:05 +0300
Subject: [PATCH 14/23] 0011: SD_H3_EVICT_PAST evict earlier segments' weights
 when capacity gate fails (default off)

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/core/segment_weight_pipeline.cpp | 27 +++++++++++++++++++++++++--
 1 file changed, 25 insertions(+), 2 deletions(-)

diff --git a/src/core/segment_weight_pipeline.cpp b/src/core/segment_weight_pipeline.cpp
index 787bbd5..3d436d5 100644
--- a/src/core/segment_weight_pipeline.cpp
+++ b/src/core/segment_weight_pipeline.cpp
@@ -2,6 +2,7 @@
 
 #include <cstdlib>
 #include <unordered_map>
+#include <unordered_set>
 #include <utility>
 
 #include "core/ggml_graph_cut.h"
@@ -176,10 +177,32 @@ namespace sd {
                     const char* e = std::getenv("SD_H3_DROP_QUEUED");
                     return e != nullptr && e[0] != '\0' && e[0] != '0';
                 }();
-                if (!drop_queued || queued_params_.empty()) {
+                // SD_H3_EVICT_PAST=1 (default off, patch 0011): E2y3 log shows the finished first block's 316.03 MB (20 tensors) still
+                // tracked at the blocks.1 gate ('released compute params 449.31 MB, 38 tensors' = 316.03 + 133.28). On failure, also evict
+                // every earlier segment's weights that the current segment does not use, then retry once.
+                static const bool evict_past = [] {
+                    const char* e = std::getenv("SD_H3_EVICT_PAST");
+                    return e != nullptr && e[0] != '\0' && e[0] != '0';
+                }();
+                const bool do_drop = drop_queued && !queued_params_.empty();
+                if (!do_drop && !evict_past) {
                     return false;
                 }
-                disable();
+                if (do_drop) {
+                    disable();
+                }
+                if (evict_past) {
+                    std::unordered_set<ggml_tensor*> current(segment_params_[segment_index].begin(), segment_params_[segment_index].end());
+                    std::vector<ggml_tensor*> past;
+                    for (size_t i = 0; i < segment_index && i < segment_params_.size(); ++i) {
+                        for (auto* tensor : segment_params_[i]) {
+                            if (current.find(tensor) == current.end()) {
+                                past.push_back(tensor);
+                            }
+                        }
+                    }
+                    manager->evict_compute_backend_params(past);
+                }
                 if (!manager->ensure_compute_backend_capacity(request, segment_params_[segment_index],
                                                               preferred_eviction_order(), segment_params_[segment_index])) {
                     return false;
-- 
