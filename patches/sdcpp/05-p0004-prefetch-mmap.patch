---
 src/core/util.cpp      | 40 ++++++++++++++++++++++++++++++++++++++++
 src/core/util.h        |  3 +++
 src/pipeline/video.cpp |  5 +++++
 3 files changed, 48 insertions(+)

diff --git a/src/core/util.cpp b/src/core/util.cpp
index 9de1ace..7e65a56 100644
--- a/src/core/util.cpp
+++ b/src/core/util.cpp
@@ -10,6 +10,7 @@
 #include <filesystem>
 #include <fstream>
 #include <locale>
+#include <mutex>
 #include <regex>
 #include <sstream>
 #include <string>
@@ -133,12 +134,44 @@ bool is_directory(const std::string& path) {
     return (attributes != INVALID_FILE_ATTRIBUTES && (attributes & FILE_ATTRIBUTE_DIRECTORY));
 }
 
+// Live mappings (path, base, size) so SD_PREFETCH_MMAP_MATCH can ask the OS to read a model file's pages ahead (see sd_mmap_prefetch_matching).
+struct MmapRegistryEntry {
+    std::string path;
+    void* base;
+    size_t size;
+};
+static std::vector<MmapRegistryEntry>& mmap_registry() {
+    static std::vector<MmapRegistryEntry> r;
+    return r;
+}
+static std::mutex& mmap_registry_mutex() {
+    static std::mutex m;
+    return m;
+}
+
+void sd_mmap_prefetch_matching(const char* substr) {
+    std::lock_guard<std::mutex> lock(mmap_registry_mutex());
+    for (auto& e : mmap_registry()) {
+        if (e.path.find(substr) == std::string::npos) {
+            continue;
+        }
+        WIN32_MEMORY_RANGE_ENTRY range{e.base, e.size};
+        const BOOL ok = PrefetchVirtualMemory(GetCurrentProcess(), 1, &range, 0);
+        LOG_INFO("PrefetchVirtualMemory('%s', %.2f GiB): %s", e.path.c_str(), e.size / 1073741824.0, ok ? "ok" : "failed");
+    }
+}
+
 class MmapWrapperImpl : public MmapWrapper {
 public:
     MmapWrapperImpl(void* data, size_t size, HANDLE hfile, HANDLE hmapping)
         : MmapWrapper(data, size), hfile_(hfile), hmapping_(hmapping) {}
 
     ~MmapWrapperImpl() override {
+        {
+            std::lock_guard<std::mutex> lock(mmap_registry_mutex());
+            auto& r = mmap_registry();
+            r.erase(std::remove_if(r.begin(), r.end(), [&](const MmapRegistryEntry& e) { return e.base == data_; }), r.end());
+        }
         UnmapViewOfFile(data_);
         CloseHandle(hmapping_);
         CloseHandle(hfile_);
@@ -193,10 +226,17 @@ std::unique_ptr<MmapWrapper> MmapWrapper::create(const std::string& filename, bo
         return nullptr;
     }
 
+    {
+        std::lock_guard<std::mutex> lock(mmap_registry_mutex());
+        mmap_registry().push_back({filename, mapped_data, file_size});
+    }
     return std::make_unique<MmapWrapperImpl>(mapped_data, file_size, file_handle, mapping_handle);
 }
 
 #else  // Unix
+
+void sd_mmap_prefetch_matching(const char*) {}
+
 #include <dirent.h>
 #include <fcntl.h>
 #include <sys/mman.h>
diff --git a/src/core/util.h b/src/core/util.h
index 0929f60..aa9e0bf 100644
--- a/src/core/util.h
+++ b/src/core/util.h
@@ -50,6 +50,9 @@ sd::Tensor<float> sd_image_to_tensor(sd_image_t image,
 
 sd::Tensor<float> clip_preprocess(const sd::Tensor<float>& image, int target_width, int target_height);
 
+// Windows: PrefetchVirtualMemory on every live mapping whose path contains substr (no-op elsewhere). Hint only, never changes data.
+void sd_mmap_prefetch_matching(const char* substr);
+
 class MmapWrapper {
 public:
     static std::unique_ptr<MmapWrapper> create(const std::string& filename, bool writable = false);
diff --git a/src/pipeline/video.cpp b/src/pipeline/video.cpp
index f071e96..98c8025 100644
--- a/src/pipeline/video.cpp
+++ b/src/pipeline/video.cpp
@@ -2057,6 +2057,11 @@ namespace sd::pipeline {
         }
         LOG_VERBOSE("sample %dx%dx%d", W, H, T);
         int64_t sampling_start         = ggml_time_ms();
+        // SD_PREFETCH_MMAP_MATCH=<substring of a model file name> (default unset = off): once the text encoder is done, ask the OS to
+        // read that (mmap'ed) file ahead instead of taking soft page faults on first touch during step 1. Order of reads only; bytes unchanged.
+        if (const char* prefetch_match = video_latent_env("SD_PREFETCH_MMAP_MATCH")) {
+            sd_mmap_prefetch_matching(prefetch_match);
+        }
         sd::Tensor<float> loaded_video_latent;
         const char* video_latent_load = video_latent_env("SD_VIDEO_LATENT_LOAD");
         if (video_latent_load != nullptr) {
