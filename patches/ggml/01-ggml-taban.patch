+static bool ggml_cuda_fattn_tile_a3_ok(const ggml_tensor * dst, const int cc) {
+    const ggml_tensor * Q = dst->src[0];
+    const ggml_tensor * K = dst->src[1];
+    const ggml_tensor * V = dst->src[2];
+    if (getenv("WAN_A3_ORIG")) { return false; }
+    if (fast_fp16_available(cc) || !GGML_CUDA_CC_IS_NVIDIA(cc) || cc < GGML_CUDA_CC_PASCAL) { return false; }
+    if (dst->src[3] || dst->src[4]) { return false; }
+    float max_bias = 0.0f, logit_softcap = 0.0f;
+    memcpy(&max_bias, (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&logit_softcap, (const float *) dst->op_params + 2, sizeof(float));
+    if (max_bias != 0.0f || logit_softcap != 0.0f) { return false; }
+    if (K->type == GGML_TYPE_F32 && V->type == GGML_TYPE_F32) {
+        if (!ggml_cuda_a3_f32kv_enabled()) { return false; }
+    } else if (K->type != GGML_TYPE_F16 || V->type != GGML_TYPE_F16) { return false; }
+    if (Q->type != GGML_TYPE_F32) { return false; }
+    if (Q->ne[0] != 128 || K->ne[0] != 128 || V->ne[0] != 128) { return false; }
+    if (Q->ne[2] % K->ne[2] != 0) { return false; }
+    for (int i = 1; i < 4; ++i) {
+        if (Q->nb[i] % 16 || K->nb[i] % 16 || V->nb[i] % 16) { return false; }
+    }
+    if (((uintptr_t) Q->data | (uintptr_t) K->data | (uintptr_t) V->data | (uintptr_t) dst->data) % 16) { return false; }
+    return true;
+}
