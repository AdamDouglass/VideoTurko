+// ---- optime: per-op GPU time table (env GGML_CUDA_OPTIME=1, off = no effect). Needs GGML_CUDA_DISABLE_GRAPHS=1. ----
+#include <chrono>
+#include <map>
+#include <string>
+#include <vector>
+struct ggml_cuda_optime_item { std::string key; cudaEvent_t e0, e1; };
+static std::vector<ggml_cuda_optime_item> ggml_cuda_optime_pending;
+static std::map<std::string, std::pair<double,long>> ggml_cuda_optime_tab;
+static std::map<std::string, std::pair<double,long>> ggml_cuda_optime_host;
+static bool ggml_cuda_optime_on() {
+    static const bool on = [] { const char * e = getenv("GGML_CUDA_OPTIME"); return e && atoi(e) == 1; }();
+    return on;
+}
+static void ggml_cuda_optime_flush() {
+    for (auto & it : ggml_cuda_optime_pending) {
+        cudaEventSynchronize(it.e1);
+        float ms = 0; cudaEventElapsedTime(&ms, it.e0, it.e1);
+        auto & t = ggml_cuda_optime_tab[it.key]; t.first += ms; t.second++;
+        cudaEventDestroy(it.e0); cudaEventDestroy(it.e1);
+    }
+    ggml_cuda_optime_pending.clear();
+}
+static void ggml_cuda_optime_dump() {
+    ggml_cuda_optime_flush();
+    std::vector<std::pair<double,std::string>> v; double tot = 0;
+    for (auto & kv : ggml_cuda_optime_tab) { v.push_back({kv.second.first, kv.first + "  n=" + std::to_string(kv.second.second)}); tot += kv.second.first; }
+    std::sort(v.rbegin(), v.rend());
+    fprintf(stderr, "=== OPTIME total %.1f ms ===\n", tot);
+    for (auto & kv : ggml_cuda_optime_host) fprintf(stderr, "OPTIMEHOST %9.1f ms  %s  n=%ld\n", kv.second.first, kv.first.c_str(), kv.second.second);
+    for (auto & p : v) fprintf(stderr, "OPTIME %9.1f ms %5.1f%%  %s\n", p.first, 100.0*p.first/tot, p.second.c_str());
+}
+static void ggml_cuda_optime_push_key(const std::string & key, cudaEvent_t e0, cudaEvent_t e1) {
+    ggml_cuda_optime_pending.push_back({key, e0, e1});
+    if (ggml_cuda_optime_pending.size() > 4096) ggml_cuda_optime_flush();
+}
+static void ggml_cuda_optime_add_host(const std::string & key, double ms) {
+    auto & t = ggml_cuda_optime_host[key]; t.first += ms; t.second++;
+}
+static void ggml_cuda_optime_push(const ggml_tensor * n, cudaEvent_t e0, cudaEvent_t e1) {
+    static bool reg = [] { atexit(ggml_cuda_optime_dump); return true; }(); (void) reg;
+    char b[256];
+    const ggml_tensor * s0 = n->src[0]; const ggml_tensor * s1 = n->src[1];
+    snprintf(b, sizeof b, "%s dst[%lld,%lld,%lld,%lld]%s%s", ggml_op_name(n->op), (long long)n->ne[0], (long long)n->ne[1], (long long)n->ne[2], (long long)n->ne[3],
+        s0 ? (std::string(" s0=") + ggml_type_name(s0->type)).c_str() : "", s1 ? (std::string(" s1=") + ggml_type_name(s1->type)).c_str() : "");
+    ggml_cuda_optime_pending.push_back({b, e0, e1});
+    if (ggml_cuda_optime_pending.size() > 4096) ggml_cuda_optime_flush();
+}
