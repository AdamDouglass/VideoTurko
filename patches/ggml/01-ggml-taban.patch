diff --git a/src/ggml-cuda/conv2d.cu b/src/ggml-cuda/conv2d.cu
index 9636db23..fceeb70d 100644
--- a/src/ggml-cuda/conv2d.cu
+++ b/src/ggml-cuda/conv2d.cu
@@ -2,6 +2,174 @@
 #include "convert.cuh"
 #include "mma.cuh"
 
+#ifdef GGML_CUDA_CUDNN_CONV2D_F32
+// ---- cuDNN F32 conv2d branch (opt-in: env GGML_CUDA_CUDNN_CONV2D=1; unset/0 = the old direct kernel, zero effect). ----
+// All tensors stay F32 (an F16 kernel is widened exactly), default (non tensor-op) math, so no precision is dropped versus
+// im2col+sgemm; the sum order differs, so results are NOT byte-identical to the old path (judge by the quality gate).
+// Workspace cap: env GGML_CUDA_CUDNN_WS_MB (default 256). The first v7 candidate that fits the cap is used.
+#include <cudnn.h>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <tuple>
+#include <array>
+
+// Patch 0010: pins the cuDNN algorithm family and caches the choice per shape (see header of the patch).
+// GGML_CUDA_CUDNN_ALGO: "gemm" (default) = only IMPLICIT_GEMM / IMPLICIT_PRECOMP_GEMM / GEMM (plain multiply-add in one fixed summation scheme,
+// no Winograd / FFT transforms); "any" = every algorithm the heuristic returns (the 0009 behaviour).
+static bool ggml_cuda_cudnn_algo_allowed(cudnnConvolutionFwdAlgo_t algo) {
+    static const bool any = [] { const char * e = getenv("GGML_CUDA_CUDNN_ALGO"); return e && strcmp(e, "any") == 0; }();
+    if (any) {
+        return true;
+    }
+    return algo == CUDNN_CONVOLUTION_FWD_ALGO_IMPLICIT_GEMM || algo == CUDNN_CONVOLUTION_FWD_ALGO_IMPLICIT_PRECOMP_GEMM ||
+           algo == CUDNN_CONVOLUTION_FWD_ALGO_GEMM;
+}
+
+static bool ggml_cuda_cudnn_conv2d_enabled() {
+    static const bool on = [] { const char * e = getenv("GGML_CUDA_CUDNN_CONV2D"); return e && e[0] == '1'; }();
+    return on;
+}
+
+// returns false (nothing written) when no allowed algorithm fits the workspace cap: the caller then runs the old kernel
+static bool conv2d_cudnn_f32(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * kernel = dst->src[0];
+    const ggml_tensor * input  = dst->src[1];
+    const auto checked = [](cudnnStatus_t status) {
+        if (status != CUDNN_STATUS_SUCCESS) {
+            GGML_ABORT("cuDNN conv2d F32 failed: %s", cudnnGetErrorString(status));
+        }
+    };
+    static const size_t ws_cap = [] {
+        const char * e = getenv("GGML_CUDA_CUDNN_WS_MB");
+        const long v = e ? atol(e) : 0;
+        return (size_t) (v > 0 ? v : 256) * 1024 * 1024;
+    }();
+    static const bool timing_on = getenv("GGML_CUDA_CUDNN_LOG") != nullptr;  // patch 0026: diagnostic timing, zero effect without the env
+    const auto ms_since = [](std::chrono::steady_clock::time_point t0) {
+        return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+    };
+    thread_local cudnnHandle_t handle = nullptr;
+    if (!handle) {
+        const auto t0 = std::chrono::steady_clock::now();
+        checked(cudnnCreate(&handle));
+        if (timing_on) {
+            fprintf(stderr, "cudnn timing: cudnnCreate %.1f ms\n", ms_since(t0));
+        }
+    }
+    checked(cudnnSetStream(handle, ctx.stream()));
+
+    // F16 kernel -> exact F32 widening (VAE weights are normally F32 already: no copy then).
+    ggml_cuda_pool_alloc<float> w_f32(ctx.pool());
+    const float * w_ptr = (const float *) kernel->data;
+    if (kernel->type == GGML_TYPE_F16) {
+        w_f32.alloc(ggml_nelements(kernel));
+        ggml_get_to_fp32_cuda(GGML_TYPE_F16)(kernel->data, w_f32.get(), ggml_nelements(kernel), ctx.stream());
+        w_ptr = w_f32.get();
+    }
+
+    cudnnTensorDescriptor_t x_desc, y_desc;
+    cudnnFilterDescriptor_t w_desc;
+    cudnnConvolutionDescriptor_t conv_desc;
+    checked(cudnnCreateTensorDescriptor(&x_desc));
+    checked(cudnnCreateTensorDescriptor(&y_desc));
+    checked(cudnnCreateFilterDescriptor(&w_desc));
+    checked(cudnnCreateConvolutionDescriptor(&conv_desc));
+    // ggml ne = [W, H, C, N]; contiguous, W fastest => cuDNN NCHW / KCRS with the same memory order.
+    checked(cudnnSetTensor4dDescriptor(x_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT,
+        (int) input->ne[3], (int) input->ne[2], (int) input->ne[1], (int) input->ne[0]));
+    checked(cudnnSetTensor4dDescriptor(y_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT,
+        (int) dst->ne[3], (int) dst->ne[2], (int) dst->ne[1], (int) dst->ne[0]));
+    checked(cudnnSetFilter4dDescriptor(w_desc, CUDNN_DATA_FLOAT, CUDNN_TENSOR_NCHW,
+        (int) kernel->ne[3], (int) kernel->ne[2], (int) kernel->ne[1], (int) kernel->ne[0]));
+    const int32_t * p = (const int32_t *) dst->op_params; // stride_x, stride_y, pad_x, pad_y, dil_x, dil_y
+    checked(cudnnSetConvolution2dDescriptor(conv_desc, p[3], p[2], p[1], p[0], p[5], p[4],
+        CUDNN_CROSS_CORRELATION, CUDNN_DATA_FLOAT));
+#if defined(CUDNN_VERSION) && CUDNN_VERSION >= 8200
+    checked(cudnnSetConvolutionMathType(conv_desc, CUDNN_FMA_MATH));  // plain FP32 FMA, never a tensor-op / TF32 path
+#else
+    checked(cudnnSetConvolutionMathType(conv_desc, CUDNN_DEFAULT_MATH));
+#endif
+
+    // same shape -> same algorithm for the whole run (tiles of equal size never differ in summation scheme)
+    using key_t = std::array<int, 17>;
+    thread_local std::map<key_t, std::pair<cudnnConvolutionFwdAlgo_t, size_t>> algo_cache;
+    const key_t key = {(int) input->ne[0], (int) input->ne[1], (int) input->ne[2], (int) input->ne[3],
+                       (int) kernel->ne[0], (int) kernel->ne[1], (int) kernel->ne[3], p[0], p[1], p[2], p[3], p[4], p[5],
+                       (int) kernel->type, 0, 0, 0};
+    cudnnConvolutionFwdAlgo_t chosen = CUDNN_CONVOLUTION_FWD_ALGO_IMPLICIT_GEMM;
+    size_t ws_bytes = 0;
+    bool found = false;
+    auto cached = algo_cache.find(key);
+    if (cached != algo_cache.end()) {
+        chosen   = cached->second.first;
+        ws_bytes = cached->second.second;
+        found    = true;
+    } else {
+        cudnnConvolutionFwdAlgoPerf_t cand[8];
+        int n_cand = 0;
+        const auto t_query = std::chrono::steady_clock::now();
+        checked(cudnnGetConvolutionForwardAlgorithm_v7(handle, x_desc, w_desc, conv_desc, y_desc, 8, &n_cand, cand));
+        if (timing_on) {
+            fprintf(stderr, "cudnn timing: algorithm query %.1f ms\n", ms_since(t_query));
+        }
+        for (int i = 0; i < n_cand && !found; ++i) {
+            if (cand[i].status != CUDNN_STATUS_SUCCESS || !ggml_cuda_cudnn_algo_allowed(cand[i].algo)) {
+                continue;
+            }
+            size_t need = 0;
+            if (cudnnGetConvolutionForwardWorkspaceSize(handle, x_desc, w_desc, conv_desc, y_desc, cand[i].algo, &need) != CUDNN_STATUS_SUCCESS) {
+                continue;
+            }
+            if (need <= ws_cap) {
+                chosen   = cand[i].algo;
+                ws_bytes = need;
+                found    = true;
+            }
+        }
+        if (found) {
+            algo_cache[key] = {chosen, ws_bytes};
+        }
+    }
+    if (!found) {
+        checked(cudnnDestroyConvolutionDescriptor(conv_desc));
+        checked(cudnnDestroyFilterDescriptor(w_desc));
+        checked(cudnnDestroyTensorDescriptor(y_desc));
+        checked(cudnnDestroyTensorDescriptor(x_desc));
+        return false;
+    }
+    ggml_cuda_pool_alloc<uint8_t> ws(ctx.pool());
+    if (ws_bytes) {
+        ws.alloc(ws_bytes);
+    }
+    static const bool verbose = getenv("GGML_CUDA_CUDNN_LOG") != nullptr;
+    if (verbose) {
+        fprintf(stderr, "cudnn conv2d: x[%lld,%lld,%lld,%lld] w[%lld,%lld,%lld,%lld] algo %d ws %zu KiB\n",
+            (long long) input->ne[0], (long long) input->ne[1], (long long) input->ne[2], (long long) input->ne[3],
+            (long long) kernel->ne[0], (long long) kernel->ne[1], (long long) kernel->ne[2], (long long) kernel->ne[3],
+            (int) chosen, ws_bytes >> 10);
+    }
+    const float alpha = 1.0f, beta = 0.0f;
+    static bool first_forward = true;
+    const bool time_this = timing_on && first_forward;
+    first_forward = false;
+    const auto t_fwd = std::chrono::steady_clock::now();
+    const cudnnStatus_t st = cudnnConvolutionForward(handle, &alpha, x_desc, input->data, w_desc, w_ptr, conv_desc,
+        chosen, ws.get(), ws_bytes, &beta, y_desc, dst->data);
+    checked(st);
+    if (time_this) {
+        cudaStreamSynchronize(ctx.stream());  // only the very first forward call is synchronised, for the timing
+        fprintf(stderr, "cudnn timing: first forward (launch + sync) %.1f ms\n", ms_since(t_fwd));
+    }
+    checked(cudnnDestroyConvolutionDescriptor(conv_desc));
+    checked(cudnnDestroyFilterDescriptor(w_desc));
+    checked(cudnnDestroyTensorDescriptor(y_desc));
+    checked(cudnnDestroyTensorDescriptor(x_desc));
+    return true;
+}
+#endif // GGML_CUDA_CUDNN_CONV2D_F32
+
 struct conv_params {
     const int64_t IW, IH;
     const int64_t OW, OH;
@@ -335,6 +503,15 @@ static void conv2d_cuda_f32(const float * X_D, const float * K_D, float * Y_D, c
 }
 
 void ggml_cuda_op_conv2d(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+#ifdef GGML_CUDA_CUDNN_CONV2D_F32
+    if (ggml_cuda_cudnn_conv2d_enabled() && dst->type == GGML_TYPE_F32 && dst->src[1]->type == GGML_TYPE_F32 &&
+        (dst->src[0]->type == GGML_TYPE_F32 || dst->src[0]->type == GGML_TYPE_F16) &&
+        ggml_is_contiguous(dst->src[0]) && ggml_is_contiguous(dst->src[1]) && ((const int32_t *) dst->op_params)[6] == 0) {
+        if (conv2d_cudnn_f32(ctx, dst)) {
+            return;
+        }
+    }
+#endif
     const ggml_tensor * kernel = dst->src[0];
     const ggml_tensor * input  = dst->src[1];
     float *             K_D    = (float *) kernel->data;
diff --git a/src/ggml-cuda/conv3d.cu b/src/ggml-cuda/conv3d.cu
index 7e4bd57a..21161417 100644
--- a/src/ggml-cuda/conv3d.cu
+++ b/src/ggml-cuda/conv3d.cu
@@ -1,6 +1,7 @@
 #include "conv3d.cuh"
 #include "convert.cuh"
 #include "mma.cuh"
+#include <cstdlib>
 
 struct conv3d_params {
     int64_t IW, IH, ID;
@@ -230,6 +231,173 @@ static __global__ void conv3d_implicit_gemm_f16(const half * __restrict__ input,
     }
 }
 
+// Implicit-GEMM SIMT conv3d kernel for Pascal (sm_61, no tensor cores).
+// SAME as the stock kernel in: 64x64 output tile, 128 threads, same grid/split_k, same k summation order
+// (per output: k increasing, FMA, f32 accumulation, then the split_k partial sums in order) -> bit-identical result.
+// Differences: shared memory holds f32 (the conversion happens at load time, not in the inner loop), k-major layout
+// allows LDS.128, global loads for the next tile are prefetched into registers, and the k -> input offset is
+// computed once per tile.
+// conv3d_params and ggml_cuda_get_physical_warp_size must already be defined (it is called from within conv3d.cu).
+template <int KW, int KH, int KD>
+static __global__ void __launch_bounds__(128, 4) conv3d_implicit_gemm_f16_simt(const half * __restrict__ input,
+                                                                              const half * __restrict__ weight,
+                                                                              float * __restrict__ output,
+                                                                              const conv3d_params P,
+                                                                              const int           split_k,
+                                                                              const bool          aligned_weights) {
+    constexpr int BM = 64, BN = 64, BKO = 64, BK = 32, LD = BN + 4;  // BKO: stock tile; split boundaries are defined by it
+    __shared__ __align__(16) float a_s[BK][LD];   // a_s[k][m]
+    __shared__ __align__(16) float b_s[BK][LD];   // b_s[k][n]
+    __shared__ int                 offs_s[2][BK]; // k -> input offset (-1: invalid)
+
+    const int tid = threadIdx.y * 32 + threadIdx.x;
+    const int iw = int(P.IW), ih = int(P.IH), id = int(P.ID);
+    const int ow = int(P.OW), oh = int(P.OH), od = int(P.OD);
+    const int kw = KW ? KW : int(P.KW), kh = KH ? KH : int(P.KH), kd = KD ? KD : int(P.KD);
+    const int ic = int(P.IC), oc = int(P.OC);
+    const int sx = int(P.ST_X), sy = int(P.ST_Y), sz = int(P.ST_Z);
+    const int dx = int(P.DL_X), dy = int(P.DL_Y), dz = int(P.DL_Z);
+    const int n_b = blockIdx.z / split_k, split = blockIdx.z % split_k;
+    const int m0 = blockIdx.y * BM, n0 = blockIdx.x * BN;
+    const int k_total = ic * kw * kh * kd;
+    const int S       = ow * oh * od;
+
+    // same split boundaries as the stock kernel (counted in tiles of 64)
+    const int tiles = (k_total + BKO - 1) / BKO;
+    const int begin = int(int64_t(tiles) * split / split_k) * BKO;
+    const int end   = int(int64_t(tiles) * (split + 1) / split_k) * BKO;
+
+    // B load position of this thread: n = tid % 64, k rows tid/64 + 2*it
+    const int  nb      = tid & 63;
+    const int  spatial = n0 + nb;
+    const bool nvalid  = spatial < S;
+    int        posn    = 0;
+    if (nvalid) {
+        const int z = spatial / (ow * oh), y = spatial / ow % oh, x = spatial % ow;
+        posn        = (z * sz * ih + y * sy) * iw + x * sx;
+    }
+    // A load position: row = tid % 64, k column = (tid/64)*8 + 16*p
+    const int arow = tid & 63;
+    const int acol = (tid >> 6) * 8;
+    // compute position: 4 (m) x 8 (n: 4 + 4)
+    const int tm = (tid >> 3) * 4, tn0 = (tid & 7) * 4, tn1 = 32 + (tid & 7) * 4;
+
+    float acc[4][8];
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+#pragma unroll
+        for (int j = 0; j < 8; ++j) {
+            acc[i][j] = 0.0f;
+        }
+    }
+
+    auto decode_off = [&](int ki) -> int {
+        if (ki >= k_total) {
+            return -1;
+        }
+        const int ci = ki / (kw * kh * kd), kz = ki / (kw * kh) % kd, ky = ki / kw % kh, kx = ki % kw;
+        return ((n_b * ic + ci) * id + kz * dz) * ih * iw + ky * dy * iw + kx * dx;
+    };
+
+    unsigned short bv[16];
+    int4           av[2];
+
+    // load the global values for tile k0 into registers (offs_s[buf] must be ready)
+    auto load_global = [&](int k0, int buf) {
+#pragma unroll
+        for (int it = 0; it < 16; ++it) {
+            const int off = offs_s[buf][(tid >> 6) + 2 * it];
+            bv[it]        = (off >= 0 && nvalid) ? __ldg((const unsigned short *) input + (off + posn)) : (unsigned short) 0;
+        }
+        if (aligned_weights) {
+#pragma unroll
+            for (int p = 0; p < 2; ++p) {
+                const int col = k0 + acol + 16 * p;
+                av[p] = (m0 + arow < oc && col < k_total) ? __ldg(((const int4 *) weight) + ((int64_t(m0 + arow) * k_total + col) >> 3)) :
+                                                            make_int4(0, 0, 0, 0);
+            }
+        }
+    };
+
+    // write the registers to shared memory
+    auto store_smem = [&](int k0) {
+#pragma unroll
+        for (int it = 0; it < 16; ++it) {
+            b_s[(tid >> 6) + 2 * it][nb] = __half2float(__ushort_as_half(bv[it]));
+        }
+        if (aligned_weights) {
+#pragma unroll
+            for (int p = 0; p < 2; ++p) {
+                const half * h = (const half *) &av[p];
+#pragma unroll
+                for (int j = 0; j < 8; ++j) {
+                    a_s[acol + 16 * p + j][arow] = __half2float(h[j]);
+                }
+            }
+        } else {
+            // unaligned weights: scalar loads (same values as the stock kernel)
+#pragma unroll
+            for (int it = 0; it < 16; ++it) {
+                const int kk = (tid >> 6) + 2 * it;
+                float     v  = 0.0f;
+                if (m0 + arow < oc && k0 + kk < k_total) {
+                    v = __half2float(weight[int64_t(m0 + arow) * k_total + k0 + kk]);
+                }
+                a_s[kk][arow] = v;
+            }
+        }
+    };
+
+    if (begin < end) {
+        if (tid < BK) {
+            offs_s[0][tid] = decode_off(begin + tid);
+        }
+        __syncthreads();
+        load_global(begin, 0);
+        int buf = 0;
+        for (int k0 = begin; k0 < end; k0 += BK) {
+            store_smem(k0);
+            const bool has_next = k0 + BK < end;
+            if (has_next && tid < BK) {
+                offs_s[buf ^ 1][tid] = decode_off(k0 + BK + tid);
+            }
+            __syncthreads();
+            if (has_next) {
+                load_global(k0 + BK, buf ^ 1);
+            }
+#pragma unroll 8
+            for (int k = 0; k < BK; ++k) {
+                const float4 a4 = *(const float4 *) &a_s[k][tm];
+                const float4 b0 = *(const float4 *) &b_s[k][tn0];
+                const float4 b1 = *(const float4 *) &b_s[k][tn1];
+                const float  a[4] = { a4.x, a4.y, a4.z, a4.w };
+                const float  b[8] = { b0.x, b0.y, b0.z, b0.w, b1.x, b1.y, b1.z, b1.w };
+#pragma unroll
+                for (int i = 0; i < 4; ++i) {
+#pragma unroll
+                    for (int j = 0; j < 8; ++j) {
+                        acc[i][j] = fmaf(a[i], b[j], acc[i][j]);
+                    }
+                }
+            }
+            __syncthreads();
+            buf ^= 1;
+        }
+    }
+
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        const int co = m0 + tm + i;
+#pragma unroll
+        for (int j = 0; j < 8; ++j) {
+            const int pos = n0 + (j < 4 ? tn0 + j : tn1 + j - 4);
+            if (co < oc && pos < S) {
+                output[(int64_t(blockIdx.z) * oc + co) * S + pos] = acc[i][j];
+            }
+        }
+    }
+}
+
 static __global__ void conv3d_reduce_split_k(const float * __restrict__ partial,
                                              float * __restrict__ output,
                                              const int total,
@@ -261,6 +429,26 @@ static void conv3d_launch_implicit_gemm(const half *          input,
     // Vector loads require both the base pointer and each weight row to be 16-byte aligned.
     const bool aligned_weights = uintptr_t(weight) % sizeof(int4) == 0 &&
                                  (params.IC * params.KW * params.KH * params.KD) % (sizeof(int4) / sizeof(half)) == 0;
+    if constexpr (!use_mma) {
+        // Pascal SIMT path: new kernel with a bit-identical result. GGML_CUDA_CONV3D_OLD=1 falls back to the stock kernel (for A/B measurement).
+        static const bool use_old = getenv("GGML_CUDA_CONV3D_OLD") != nullptr;
+        if (!use_old) {
+            if (params.KW == 3 && params.KH == 3 && params.KD == 3) {
