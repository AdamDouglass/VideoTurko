+// ---- im2col fast path (2D/1D). Same values as im2col_kernel (pure data movement + the same float->T conversion);
+// the int64 div/mod of (iic, ikh, ikw) is done once per thread in int32 and amortised over X_TILE output columns.
+// Env GGML_CUDA_IM2COL_FAST=0 selects the old kernel (unset or any other value = fast path). ----
+#define IM2COL_FAST_X_TILE 8
+
+static bool ggml_cuda_im2col_fast_enabled() {
+    static const bool on = [] { const char * e = getenv("GGML_CUDA_IM2COL_FAST"); return !(e && e[0] == '0'); }();
+    return on;
+}
+
+template <typename T, int X_TILE>
+static __global__ void im2col_xtile_kernel(
+        const float * __restrict__ x, T * __restrict__ dst,
+        int IC_KH_KW, int KH_KW, int KW, int IH, int IW, int OH, int OW,
+        int64_t IC_IH_IW, int64_t IH_IW,
+        int s0, int s1, int p0, int p1, int d0, int d1) {
+    const int c = blockIdx.x * blockDim.x + threadIdx.x; // = iic*KH*KW + ikh*KW + ikw (contiguous in dst)
+    if (c >= IC_KH_KW) {
+        return;
+    }
+    const int iic = c / KH_KW;
+    const int rem = c - iic * KH_KW;
+    const int ikh = rem / KW;
+    const int ikw = rem - ikh * KW;
+
+    const int iz  = blockIdx.z; // = in*OH + ioh
+    const int in  = iz / OH;
+    const int ioh = iz - in * OH;
+    const int base_iow = blockIdx.y * X_TILE;
+
+    const int iih = ioh * s1 + ikh * d1 - p1;
+    const bool h_ok = iih >= 0 && iih < IH;
+    const int64_t src_row = (int64_t) iic * IC_IH_IW + (int64_t) in * IH_IW + (int64_t) iih * IW; // only dereferenced if h_ok
