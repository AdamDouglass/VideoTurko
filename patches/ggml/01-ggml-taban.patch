+
+#pragma unroll
+    for (int dx = 0; dx < X_TILE; ++dx) {
+        const int iow = base_iow + dx;
+        if (iow >= OW) {
+            return;
+        }
+        const int iiw = iow * s0 + ikw * d0 - p0;
+        const int64_t offset_dst = dst_row + (int64_t) dx * IC_KH_KW;
+        if (!h_ok || iiw < 0 || iiw >= IW) {
+            dst[offset_dst] = 0.0f;
+        } else {
+            dst[offset_dst] = x[src_row + iiw];
+        }
+    }
