+                conv3d_implicit_gemm_f16_simt<1, 1, 1>
+                    <<<grid, block, 0, stream>>>(input, weight, output, params, split_k, aligned_weights);
+            } else {
+                conv3d_implicit_gemm_f16_simt<0, 0, 0>
